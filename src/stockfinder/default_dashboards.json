{
  "version": 1,
  "dashboards": [
    {
      "id": "daily-command-center",
      "title": "Daily Command Center",
      "description": "Market risk, regional rotation, and instrument evidence in one linked view.",
      "widgets": [
        {
          "id": "market-regime",
          "type": "market_regime",
          "title": "Market Risk and Controls",
          "width": 4
        },
        {
          "id": "cross-asset-conditions",
          "type": "cross_asset_conditions",
          "title": "Cross-Asset Conditions",
          "width": 8
        },
        {
          "id": "regional-markets",
          "type": "regional_markets",
          "title": "Regional Markets",
          "width": 12,
          "follow_context": true
        },
        {
          "id": "rotation-explorer",
          "type": "rotation_explorer",
          "title": "Regional, Sector, and Industry Rotation",
          "width": 6,
          "follow_context": true
        },
        {
          "id": "liquidity-breadth",
          "type": "liquidity_breadth",
          "title": "Liquidity Flow and Market Breadth",
          "width": 6,
          "follow_context": true
        },
        {
          "id": "ranked-stocks",
          "type": "ranked_stocks",
          "title": "Ranked Industry Stocks",
          "width": 7,
          "follow_context": true,
          "settings": {
            "broker_only": false
          }
        },
        {
          "id": "instrument-analysis",
          "type": "instrument_analysis",
          "title": "Stock, ETF, or Index Analysis",
          "width": 5,
          "follow_context": true,
          "settings": {
            "default_symbol": "SPY"
          }
        },
        {
          "id": "rule-profile-editor",
          "type": "rule_profile_editor",
          "title": "Rule Profile Controls",
          "width": 12
        }
      ]
    },
    {
      "id": "instrument-workbench",
      "title": "Instrument Workbench",
      "description": "Focused technical, quality, and risk inspection for any supported symbol.",
      "widgets": [
        {
          "id": "instrument-analysis-wide",
          "type": "instrument_analysis",
          "title": "Instrument Analysis",
          "width": 12,
          "follow_context": true,
          "settings": {
            "default_symbol": "QQQ"
          }
        },
        {
          "id": "fundamental-evidence",
          "type": "security_score_evidence",
          "title": "Fundamental Evidence",
          "width": 4,
          "follow_context": true,
          "settings": {
            "dimension": "fundamental",
            "default_symbol": "QQQ"
          }
        },
        {
          "id": "risk-evidence",
          "type": "security_score_evidence",
          "title": "Safety Evidence",
          "width": 4,
          "follow_context": true,
          "settings": {
            "dimension": "risk",
            "default_symbol": "QQQ"
          }
        },
        {
          "id": "technical-evidence",
          "type": "security_score_evidence",
          "title": "Technical Evidence",
          "width": 4,
          "follow_context": true,
          "settings": {
            "dimension": "technical",
            "default_symbol": "QQQ"
          }
        },
        {
          "id": "trade-plan",
          "type": "trade_plan",
          "title": "Risk and Trade Plan",
          "width": 12,
          "follow_context": true,
          "settings": {
            "default_symbol": "QQQ"
          }
        },
        {
          "id": "peer-comparison",
          "type": "peer_comparison",
          "title": "Peer and Benchmark Comparison",
          "width": 12,
          "follow_context": true,
          "settings": {
            "default_symbol": "QQQ"
          }
        }
      ]
    },
    {
      "id": "portfolio-monitor",
      "title": "Portfolio Monitor",
      "description": "Concentration, exposure controls, and watchlist access from cached market evidence.",
      "widgets": [
        {
          "id": "alert-center",
          "type": "alert_center",
          "title": "Portfolio and Watchlist Alerts",
          "width": 12,
          "follow_context": true
        },
        {
          "id": "portfolio-exposure",
          "type": "portfolio_exposure",
          "title": "Portfolio Exposure and Watchlist",
          "width": 12,
          "follow_context": true,
          "settings": {
            "base_currency": "EUR"
          }
        }
      ]
    }
  ]
}
